<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paper labels and brown ink, with the same copper-green deepened to read on paper. -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F5EFE4" />
    <SolidColorBrush x:Key="SidebarBackground" Color="#EEE6D7" />
    <SolidColorBrush x:Key="Surface" Color="#FCF9F3" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F0E9DC" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#EAE2D2" />
    <SolidColorBrush x:Key="InputBackground" Color="#FFFDF9" />
    <SolidColorBrush x:Key="LogBackground" Color="#F7F2E8" />
    <SolidColorBrush x:Key="Border" Color="#DED3C1" />
    <SolidColorBrush x:Key="BorderStrong" Color="#C2B49F" />
    <SolidColorBrush x:Key="TextPrimary" Color="#2A2118" />
    <SolidColorBrush x:Key="TextSecondary" Color="#5E5143" />
    <SolidColorBrush x:Key="TextMuted" Color="#6F6253" />
    <SolidColorBrush x:Key="Accent" Color="#17695C" />
    <SolidColorBrush x:Key="AccentHover" Color="#12574C" />
    <SolidColorBrush x:Key="AccentPressed" Color="#0E473E" />
    <SolidColorBrush x:Key="AccentSoft" Color="#DCEBE3" />
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Selection" Color="#E0EADF" />
    <SolidColorBrush x:Key="Danger" Color="#B4382A" />
    <SolidColorBrush x:Key="DangerSoft" Color="#F8E4DE" />
    <SolidColorBrush x:Key="Warning" Color="#8A5608" />
    <SolidColorBrush x:Key="WarningSoft" Color="#F6E6C8" />
    <SolidColorBrush x:Key="Success" Color="#1F7340" />
    <SolidColorBrush x:Key="Info" Color="#2A6392" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#CFC3AF" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#A99A83" />
    <SolidColorBrush x:Key="Shadow" Color="#22000000" />
</ResourceDictionary>
