<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark stained wood, with the copper-green accent from the fittings on the icon. -->
    <SolidColorBrush x:Key="WindowBackground" Color="#16120E" />
    <SolidColorBrush x:Key="SidebarBackground" Color="#120F0B" />
    <SolidColorBrush x:Key="Surface" Color="#1E1914" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#29221B" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#2C251D" />
    <SolidColorBrush x:Key="InputBackground" Color="#1A1510" />
    <SolidColorBrush x:Key="LogBackground" Color="#110E0A" />
    <SolidColorBrush x:Key="Border" Color="#3A3026" />
    <SolidColorBrush x:Key="BorderStrong" Color="#54473A" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F4ECDF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#C2B5A3" />
    <SolidColorBrush x:Key="TextMuted" Color="#A09382" />
    <SolidColorBrush x:Key="Accent" Color="#6CCBB4" />
    <SolidColorBrush x:Key="AccentHover" Color="#8ADAC6" />
    <SolidColorBrush x:Key="AccentPressed" Color="#52B39C" />
    <SolidColorBrush x:Key="AccentSoft" Color="#1E3430" />
    <SolidColorBrush x:Key="AccentForeground" Color="#08201B" />
    <SolidColorBrush x:Key="Selection" Color="#233029" />
    <SolidColorBrush x:Key="Danger" Color="#F28B7D" />
    <SolidColorBrush x:Key="DangerSoft" Color="#3D211C" />
    <SolidColorBrush x:Key="Warning" Color="#E8B56A" />
    <SolidColorBrush x:Key="WarningSoft" Color="#3A2C19" />
    <SolidColorBrush x:Key="Success" Color="#8FD19E" />
    <SolidColorBrush x:Key="Info" Color="#8DB8DE" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#4A3F33" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#66584A" />
    <SolidColorBrush x:Key="Shadow" Color="#80000000" />
</ResourceDictionary>
