<Window x:Class="AppMigrate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AppMigrate.ViewModels"
        Title="AppMigrate"
        Width="1360"
        Height="840"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        Icon="Assets/AppMigrate.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <vm:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,24,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                    <Border Width="42" Height="42" CornerRadius="11" ClipToBounds="True">
                        <Viewbox Stretch="Uniform">
                            <Grid Width="256" Height="256">
                                <Border CornerRadius="48">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0A1A33" Offset="0" />
                                            <GradientStop Color="#0E7C86" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Path Data="M 42,64 L 196,64"
                                      Stroke="#F8FDFF"
                                      StrokeThickness="20"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <Path Data="M 184,32 L 230,64 L 184,96 Z" Fill="#F8FDFF" />
                                <Border Width="86" Height="94"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Margin="32,0,0,30"
                                        CornerRadius="18"
                                        Background="#F3FBFF" />
                                <Border Width="86" Height="94"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,32,30"
                                        CornerRadius="18"
                                        Background="#65E6F2"
                                        BorderBrush="#66FFFFFF"
                                        BorderThickness="2" />
                            </Grid>
                        </Viewbox>
                    </Border>
                    <StackPanel Margin="12,1,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AppMigrate" Style="{StaticResource H2}" />
                        <TextBlock Text="Windows migration" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <TextBlock Text="WORKSPACE" Style="{StaticResource Caption}" Margin="12,0,0,9" />
                    <RadioButton x:Name="CollectNav"
                                 Style="{StaticResource NavRadio}"
                                 Tag="&#xE71D;"
                                 Content="Collect apps"
                                 IsChecked="True"
                                 Checked="CollectNav_Checked" />
                    <RadioButton x:Name="InstallNav"
                                 Style="{StaticResource NavRadio}"
                                 Tag="&#xE896;"
                                 Content="Install apps"
                                 Checked="InstallNav_Checked" />
                </StackPanel>

                <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,18">
                    <Border Background="{DynamicResource SurfaceAlt}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="LIVE INVENTORY" Style="{StaticResource Caption}" />
                            <TextBlock Text="Registry · AppX · WinGet" Style="{StaticResource Subtle}" Margin="0,5,0,0" />
                            <TextBlock Text="Scanned in parallel" Style="{StaticResource Subtle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Button x:Name="ThemeButton"
                            Style="{StaticResource GhostButton}"
                            Content="Switch theme"
                            HorizontalAlignment="Left"
                            Padding="10,6"
                            Click="ThemeButton_Click" />
                    <TextBlock x:Name="VersionText"
                               Text="v1.1.0"
                               Style="{StaticResource Caption}"
                               Margin="10,8,0,0"
                               Opacity="0.7" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="28,24,28,0">
                <!-- Collect view -->
                <Grid x:Name="CollectView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Collect apps" Style="{StaticResource H1}" />
                            <TextBlock Text="See what is installed, choose what to keep, and save a portable manifest."
                                       Style="{StaticResource Subtle}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="OpenButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Open..."
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding CanEdit}"
                                    Click="OpenButton_Click" />
                            <Button x:Name="SaveButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Save manifest"
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding CanEdit}"
                                    Click="SaveButton_Click" />
                            <Button x:Name="ScanButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Scan this PC"
                                    Command="{Binding ScanCommand}" />
                        </StackPanel>
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16,13">
                            <StackPanel>
                                <TextBlock Text="Detected" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding TotalCount}" Style="{StaticResource StatValue}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16,13">
                            <StackPanel>
                                <TextBlock Text="Selected" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding SelectedCount}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Accent}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16,13">
                            <StackPanel>
                                <TextBlock Text="WinGet" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding WingetCount}" Style="{StaticResource StatValue}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16,13">
                            <StackPanel>
                                <TextBlock Text="Manual" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding ManualCount}" Style="{StaticResource StatValue}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Search apps, IDs, categories..." />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}"
                                        Content="Select visible"
                                        Command="{Binding SelectVisibleCommand}"
                                        Padding="10,6" />
                                <Button Style="{StaticResource GhostButton}"
                                        Content="Clear visible"
                                        Command="{Binding ClearVisibleCommand}"
                                        Padding="10,6" />
                                <Button Style="{StaticResource GhostButton}"
                                        Content="Defaults"
                                        Command="{Binding RestoreDefaultsCommand}"
                                        Padding="10,6" />
                            </StackPanel>
                        </Grid>
                        <ListBox Grid.Row="1"
                                 Style="{StaticResource FilterListBox}"
                                 ItemsSource="{Binding Filters}"
                                 SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource FilterItem}"
                                 DisplayMemberPath="Label"
                                 Margin="0,10,0,0"
                                 VerticalAlignment="Center">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Grid>

                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <DataGrid x:Name="AppsGrid"
                                      ItemsSource="{Binding AppsView}"
                                      IsEnabled="True"
                                      SelectionMode="Single"
                                      MouseDoubleClick="AppsGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="46" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="App" Width="250" SortMemberPath="Name">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="30" Height="30" CornerRadius="8"
                                                            Background="{DynamicResource AccentSoft}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Initial}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Accent}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="14" />
                                                    </Border>
                                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Name}" />
                                                        <TextBlock Text="{Binding Publisher}"
                                                                   Style="{StaticResource Caption}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Type" Width="80" SortMemberPath="TypeLabel">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TypeLabel}" Value="WinGet">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding TypeLabel}" Value="Manual">
                                                                    <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding TypeLabel}" FontSize="11.5" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding TypeLabel}" Value="WinGet">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding TypeLabel}" Value="Manual">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="105" IsReadOnly="True" SortMemberPath="Category" />
                                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="116" IsReadOnly="True" SortMemberPath="Version" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="290" IsReadOnly="True" SortMemberPath="Id" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" IsReadOnly="True" SortMemberPath="Notes" ElementStyle="{StaticResource GridCellText}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasApps, Converter={StaticResource InverseBoolToVis}}">
                                <Border Width="64" Height="64" CornerRadius="18"
                                        Background="{DynamicResource AccentSoft}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE71D;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="26"
                                               Foreground="{DynamicResource Accent}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="No apps loaded"
                                           Style="{StaticResource H2}"
                                           HorizontalAlignment="Center"
                                           Margin="0,14,0,0" />
                                <TextBlock Text="Scan this PC to build a live inventory from Registry, AppX, and WinGet."
                                           Style="{StaticResource Subtle}"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0" />
                                <Button Content="Scan this PC"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ScanCommand}"
                                        HorizontalAlignment="Center"
                                        Margin="0,16,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Install view -->
                <Grid x:Name="InstallView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Install apps" Style="{StaticResource H1}" />
                            <TextBlock Text="Preview the plan, then let WinGet rebuild the selected apps."
                                       Style="{StaticResource Subtle}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="LoadButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Load manifest..."
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding CanEdit}"
                                    Click="LoadButton_Click" />
                            <Button x:Name="PreviewButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Preview plan"
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding CanEdit}"
                                    Click="PreviewButton_Click" />
                            <Button x:Name="InstallButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Install selected"
                                    IsEnabled="{Binding CanInstall}"
                                    Click="InstallButton_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="ACTIVE MANIFEST" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding ManifestLabel}"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ManifestLabel}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                <CheckBox Content="Force reinstall" IsChecked="{Binding ForceReinstall}" IsEnabled="{Binding CanEdit}" Margin="0,0,18,0" />
                                <CheckBox Content="Allow interactive" IsChecked="{Binding AllowInteractive}" IsEnabled="{Binding CanEdit}" Margin="0,0,18,0" />
                                <CheckBox Content="Skip Store" IsChecked="{Binding SkipStore}" IsEnabled="{Binding CanEdit}" Margin="0,0,18,0" />
                                <CheckBox Content="Match scope" IsChecked="{Binding MatchScope}" IsEnabled="{Binding CanEdit}" Margin="0,0,18,0" />
                                <CheckBox Content="Pin versions" IsChecked="{Binding PinVersions}" IsEnabled="{Binding CanEdit}" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource SoftCard}" Margin="0,0,0,14" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource Subtle}" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="1"
                                         Height="4"
                                         Maximum="100"
                                         Value="{Binding ProgressValue, Mode=OneWay}"
                                         VerticalAlignment="Center"
                                         IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="2*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                            <Grid>
                                <DataGrid x:Name="PlanGrid" ItemsSource="{Binding PlanItems}" MouseDoubleClick="PlanGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Action" Width="86" SortMemberPath="Action">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Action}" Value="Install">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Action}" Value="Manual">
                                                                        <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Action}" FontSize="11.5" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Action}" Value="Install">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Action}" Value="Manual">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="App" Binding="{Binding Name}" Width="300" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource GridCellText}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding HasPlan, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="No plan yet"
                                               Style="{StaticResource H2}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Preview a plan to see what will be installed, skipped, or handled manually."
                                               Style="{StaticResource Subtle}"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0" />
                                    <Button Content="Preview plan"
                                            Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Center"
                                            Margin="0,14,0,0"
                                            Click="PreviewButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent" ShowsPreview="False" />

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="14,10,14,4">
                                    <TextBlock Text="ACTIVITY" Style="{StaticResource Caption}" />
                                    <TextBlock Text="Live WinGet output" Style="{StaticResource Caption}" HorizontalAlignment="Right" Opacity="0.7" />
                                </Grid>
                                <TextBox Grid.Row="1"
                                         x:Name="LogBox"
                                         Text="{Binding LogText, Mode=OneWay}"
                                         Style="{StaticResource LogTextBox}"
                                         TextChanged="LogBox_TextChanged" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,1,0,0"
                    Padding="18,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusText}"
                               Style="{StaticResource Subtle}"
                               Margin="9,0,16,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding SelectedCount, StringFormat={}{0} selected}"
                               Style="{StaticResource Caption}"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding TotalCount, StringFormat={}{0} detected}"
                               Style="{StaticResource Caption}"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <Button Grid.Column="4"
                            Style="{StaticResource DangerButton}"
                            Content="Cancel"
                            Padding="10,5"
                            MinHeight="30"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>



